# Secrets and local state never belong in an image layer.
.env
.env.*
!.env.example

# Local build output and dependencies, rebuilt inside the image.
.next
node_modules

# Version control and editor state.
.git
.gitignore

# Local logs, screenshots and scratch scripts.
tmp-*

# Tests and tooling that the image never runs.
tests
playwright-report
test-results
