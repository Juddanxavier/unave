# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Transactional email. Server only, never prefix these with NEXT_PUBLIC_.
# Verified sender address and the reply inbox. Required for any send.
MAIL_FROM_ADDRESS=hello@your-domain.example
MAIL_FROM_NAME=Unave
MAIL_REPLY_TO=hello@your-domain.example

# ZeptoMail primary. The token is a send token, not an account password.
# Set the regional host when the account lives in another zone.
ZEPTOMAIL_API_KEY=YOUR_ZEPTOMAIL_SEND_TOKEN
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# SMTP fallback, on a different provider from ZeptoMail.
# Use true for implicit TLS on port 465, false for STARTTLS.
SMTP_HOST=smtp.your-fallback.example
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_SECURE=false

# Customer sign-in. Optional: leave these blank and the site runs exactly as it did
# before accounts existed. Server only, never prefix with NEXT_PUBLIC_.
# Create a Google Cloud OAuth 2.0 client of type "Web application" and register the
# authorized redirect URI for every environment, including localhost:
#   {NEXT_PUBLIC_SERVER_URL}/api/customers/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay. Checkout, subscriptions and webhooks (spec 0007). Server only, never
# prefix with NEXT_PUBLIC_ — the secret must never reach the browser.
# Test mode keys start with rzp_test_, live keys with rzp_live_.
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The webhook secret from the dashboard's webhook settings, for `payment.captured`
# and `payment.failed` events. Optional: without it checkout still works (the
# confirm step verifies payments), but the database only hears about payments
# through the browser until this is set.
RAZORPAY_WEBHOOK_SECRET=
